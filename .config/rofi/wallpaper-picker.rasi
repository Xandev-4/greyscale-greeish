@import "~/.config/rofi/colors.rasi"

configuration {
    show-icons: true;
}

* {
    background-color: transparent;
    text-color: @foreground;
    border: 0;
    margin: 0;
    padding: 0;
    spacing: 0;
    font: "monospace 12";
}

window {
    transparency: "real";
    background-color: @background;
    text-color: @foreground;
    border: 3px;
    border-color: @border;
    border-radius: 10px;
    width: 42%;
    padding: 14px;
}

mainbox {
    background-color: transparent;
    children: [inputbar, listview];
    spacing: 10px;
}

inputbar {
    background-color: transparent;
    children: [prompt, entry];
    spacing: 8px;
    padding: 2px 4px 8px 4px;
}

prompt {
    enabled: true;
    background-color: transparent;
    text-color: @prompt;
    padding: 0;
    margin: 0 6px 0 0;
    str: "Wallpaper:";
}

entry {
    background-color: transparent;
    text-color: @input;
    placeholder-color: @placeholder;
    padding: 0;
}

listview {
    background-color: transparent;
    columns: 1;
    lines: 8;
    spacing: 2px;
    cycle: false;
    dynamic: true;
    scrollbar: false;
}

element {
    background-color: transparent;
    text-color: @foreground;
    orientation: horizontal;
    border-radius: 8px;
    padding: 2px 8px;
    spacing: 8px;
}

element-icon {
    background-color: transparent;
    size: 40px;
    border: 0;
}
element selected {
    background-color: @selected;
    text-color: @selected-text;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    expand: true;
    vertical-align: 0.5;
}

textbox-prompt-colon {
    expand: false;
    str: "";
}
