set -U fish_greeting

set -gx PATH /home/xandev/.nvm/versions/node/v22.20.0/bin $PATH
set -x -U EDITOR nvim
set -x -U VISUAL nvim
set -gx QT_QPA_PLATFORMTHEME qt6ct

if status is-interactive
  # Commands to run in interactive sessions can go here
  alias ls "lsd -la"
  alias tree "lsd --tree"
  alias v "nvim"
  alias cat "bat"
  alias pn pnpm
  alias qwen "ollama run qwen2.5-coder:7b-instruct-q5_k_m"
  alias lg lazygit
  alias damxInstall "sudo LLVM=1"
end

starship init fish | source
zoxide init fish | source

