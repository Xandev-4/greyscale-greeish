* {
    background: #{{colors.background.default.hex_stripped}}b3;
    foreground: #{{colors.on_surface.default.hex_stripped}}ff;

    prompt: #{{colors.secondary.default.hex_stripped}}ff;
    placeholder: #{{colors.tertiary.default.hex_stripped}}ff;
    input: #{{colors.on_surface.default.hex_stripped}}ff;
    match: #{{colors.tertiary.default.hex_stripped}}ff;

    selected: #{{colors.primary.default.hex_stripped}}ff;
    selected-text: #{{colors.on_primary.default.hex_stripped}}ff;
    selected-match: #{{colors.on_primary.default.hex_stripped}}ff;

    border: #{{colors.primary.default.hex_stripped}}ff;
}
